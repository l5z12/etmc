# Lombok settings for every module (common/, src/, paper/).
#
# etmc's accessors are fluent — state(), session(), relays() — not getState(). That matches the
# records the rest of core uses, so the generated ones have to follow the same shape or every call
# site would have to be renamed.
config.stopBubbling = true
lombok.accessors.fluent = true
lombok.accessors.chain = false

# Keep the shipped bytecode free of references to Lombok itself. Lombok is compileOnly, so it is
# absent at runtime; @lombok.Generated markers (and @ConstructorProperties) would leave the jar
# pointing at classes no loader can resolve, for no benefit — there is no coverage tooling here.
lombok.addLombokGeneratedAnnotation = false
lombok.anyConstructor.addConstructorProperties = false
