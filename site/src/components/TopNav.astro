---
const path = Astro.url.pathname.replace(/(index)?\.html$/, '').replace(/\/$/, '') || '/';
---

<header class="site-header ink" style={path === '/' ? 'background:none' : undefined}>
  <div class="wrap">
    <a class="brand" href="/">
      <svg class="mark" viewBox="0 0 512 512" aria-hidden="true">
        <g transform="rotate(-45 256 256)">
          <rect class="a" x="152" y="230" width="104" height="52" />
          <rect class="b" x="256" y="230" width="104" height="52" />
          <rect class="a" x="68" y="172" width="168" height="168" />
          <rect class="b" x="276" y="172" width="168" height="168" />
        </g>
      </svg>
      etmc
    </a>
    <nav aria-label="Main">
      <a href="/docs/getting-started" aria-current={path.startsWith('/docs') ? 'page' : undefined}>Docs</a>
      <a href="/generator" aria-current={path === '/generator' ? 'page' : undefined}>Generator</a>
      <a class="github" href="https://github.com/L5Z12/etmc">GitHub</a>
      <a class="btn primary small" href="https://github.com/L5Z12/etmc/releases">Download</a>
    </nav>
  </div>
</header>
