---
import { renderCubes, type Cube } from '../lib/iso';
import { i18n } from '../i18n';

const { route: t } = i18n(Astro.url).t;

const block = (color: string): string => {
  const cubes: Cube[] = [];
  for (let x = 0; x < 2; x++) for (let y = 0; y < 2; y++) for (let z = 0; z < 2; z++) cubes.push({ x, y, z, color });
  return renderCubes(cubes);
};

const direct = 'M 140 215 L 580 215';
const viaRelay = 'M 140 215 L 360 110 L 580 215';
---

<div class="route" id="route" data-route="direct">
  <div class="route-copy">
    <h2>{t.title}</h2>
    <p>{t.body}</p>

    <div class="route-toggle" role="group" aria-label={t.toggle}>
      <button type="button" data-set="direct" aria-pressed="true">{t.direct}</button>
      <button type="button" data-set="relay" aria-pressed="false">{t.relay}</button>
    </div>
    <p class="route-note" data-for="direct">{t.directNote}</p>
    <p class="route-note" data-for="relay">{t.relayNote}</p>
  </div>

  <svg viewBox="0 24 720 290" role="img" aria-label={t.diagram}>
    <path class="wire intro" d={viaRelay} />
    <path class="wire direct" d={direct} />
    <path class="wire relay" d={viaRelay} />

    <rect class="packet direct" style={`offset-path:path('${direct}')`} x="-6" y="-6" width="12" height="12" />
    <rect class="packet direct late" style={`offset-path:path('${direct}')`} x="-6" y="-6" width="12" height="12" />
    <rect class="packet relay" style={`offset-path:path('${viaRelay}')`} x="-6" y="-6" width="12" height="12" />
    <rect class="packet relay late" style={`offset-path:path('${viaRelay}')`} x="-6" y="-6" width="12" height="12" />

    <g transform="translate(140 218)" set:html={block('#f4f1e8')} />
    <g transform="translate(580 218)" set:html={block('#62d0e0')} />
    <g transform="translate(360 112) scale(.75)" set:html={block('#fcdc5f')} />

    <text x="140" y="298" text-anchor="middle">{t.you}</text>
    <text x="580" y="298" text-anchor="middle">{t.friend}</text>
    <text x="360" y="54" text-anchor="middle">{t.relayNode}</text>
  </svg>
</div>

<style>
  .route { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 56px; align-items: center; }
  .route h2 { margin-top: 0; }
  .route-copy > p { color: var(--muted); }
  .route-toggle { display: inline-flex; flex-wrap: wrap; margin: 8px 0 14px; border: 2px solid var(--line); }
  .route-toggle button {
    min-height: 42px; padding: 0 16px; border: 0; background: none; color: var(--muted);
    font: 600 0.95rem var(--sans); cursor: pointer;
  }
  .route-toggle button[aria-pressed='true'] { background: var(--accent); color: var(--on-accent); }
  .route-note { min-height: 3.2em; margin: 0; font-size: 0.95rem; }

  svg { display: block; width: 100%; height: auto; }
  text { fill: var(--ink); font: 600 17px var(--sans); }
  .wire { fill: none; stroke-width: 3; }
  .wire.intro { stroke: var(--line); stroke-dasharray: 3 9; }
  .wire.direct { stroke: #f4f1e8; }
  .wire.relay { stroke: #fcdc5f; }
  .packet { fill: #62d0e0; offset-rotate: 0deg; }
  .packet.relay { fill: #fcdc5f; }

  [data-route='direct'] .relay, [data-route='relay'] .direct,
  [data-route='direct'] [data-for='relay'], [data-route='relay'] [data-for='direct'] { display: none; }

  @media (prefers-reduced-motion: no-preference) {
    .packet { animation: along 2.4s linear infinite; }
    .packet.relay { animation-duration: 3.2s; }
    .packet.late { animation-delay: -1.2s; }
    .packet.relay.late { animation-delay: -1.6s; }
  }
  @media (prefers-reduced-motion: reduce) { .packet { display: none; } }
  @keyframes along { from { offset-distance: 0%; } to { offset-distance: 100%; } }

  @media (max-width: 860px) { .route { grid-template-columns: minmax(0, 1fr); gap: 28px; } }
</style>

<script>
  const route = document.getElementById('route')!;
  const buttons = route.querySelectorAll<HTMLButtonElement>('[data-set]');
  buttons.forEach((button) => button.addEventListener('click', () => {
    route.dataset.route = button.dataset.set;
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
  }));
</script>
