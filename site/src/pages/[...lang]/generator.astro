---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { i18n, localePaths } from '../../i18n';

export const getStaticPaths = localePaths;

const { t: { generator: t, config } } = i18n(Astro.url);

// The script's own strings, in this page's language (see lib/generatorUi.ts).
const scriptStrings = JSON.stringify({ script: t.script, config }).replace(/</g, '\\u003c');
---

<BaseLayout title={t.title} description={t.description}>
  <div class="ink">
    <div class="wrap page-title">
      <h1>{t.title}</h1>
      <p>{t.intro}</p>
    </div>
  </div>

  <div class="wrap tool gen" id="gen" data-mode="paper">

    <div class="modes" role="group" aria-label={t.modes}>
      <button id="mode-paper" type="button" aria-pressed="true">{t.paper}</button>
      <button id="mode-player" type="button" aria-pressed="false">{t.player}</button>
      <button id="mode-link" type="button" aria-pressed="false">{t.link}</button>
    </div>

    <p class="intro paper-only">{t.paperIntro}</p>
    <p class="intro client-only">{t.playerIntro}</p>
    <p class="intro link-only" set:html={t.linkIntro} />

    <div class="card load">
      <label class="field">
        <span>{t.load} <span class="hint">{t.loadHint}</span></span>
        <input id="f-link" type="text" placeholder="etmc://v1/…" autocomplete="off" spellcheck="false" />
      </label>
      <p id="load-msg" class="status" role="status"></p>
    </div>

    <div class="tool-grid">
      <div class="card">
        <label class="field">
          <span>{t.network}</span>
          <input id="f-network" type="text" value="my-smp" autocomplete="off" spellcheck="false" />
        </label>

        <div class="field">
          <label class="field-label" for="f-secret">{t.secret} <span class="hint">{t.secretHint}</span></label>
          <div class="with-button">
            <input id="f-secret" type="text" autocomplete="off" spellcheck="false" />
            <button id="new-secret" class="btn small" type="button">{t.newSecret}</button>
          </div>
          <p class="warn" set:html={t.secretWarning} />
        </div>

        <label class="field">
          <span>{t.relays} <span class="hint">{t.relaysHint}</span></span>
          <textarea id="f-relays" rows="3" spellcheck="false" placeholder="tcp://my.relay:11010"></textarea>
        </label>

        <label class="check client-only">
          <input id="f-dhcp" type="checkbox" checked />
          {t.dhcp}
        </label>

        <label class="field client-only">
          <span>{t.playerIp} <span class="hint">{t.playerIpHint}</span></span>
          <input id="f-ipv4" type="text" value="10.126.126.2" autocomplete="off" spellcheck="false" disabled />
        </label>

        <div class="pair">
          <label class="field mesh-only">
            <span>{t.serverIp} <span class="hint">{t.serverIpHint}</span></span>
            <input id="f-serverip" type="text" value="10.126.126.1" autocomplete="off" spellcheck="false" />
          </label>
          <label class="field">
            <span id="lbl-port">{t.port}</span>
            <input id="f-serverport" type="number" value="25565" min="1" max="65535" />
          </label>
        </div>

        <label class="field mesh-only">
          <span>{t.serverName} <span class="hint">{t.serverNameHint}</span></span>
          <input id="f-label" type="text" value="My Server" autocomplete="off" spellcheck="false" />
        </label>

        <label class="field mesh-only">
          <span>{t.hostKey} <span class="hint">{t.hostKeyHint}</span></span>
          <input id="f-hostkey" type="text" autocomplete="off" spellcheck="false" />
        </label>
      </div>

      <div class="card output-card">
        <div class="field-label" id="lbl-out">config.yml</div>
        <pre class="output" id="out-pre"><code id="out"></code></pre>
        <div class="actions" id="acts-file">
          <button id="copy" class="btn primary" type="button">{t.copy}</button>
          <button id="download" class="btn" type="button">{t.download}</button>
        </div>
        <div class="actions link-only">
          <button id="copy-link" class="btn primary" type="button">{t.copyLink}</button>
        </div>
        <p id="toast" class="status" role="status"></p>
        <p id="errs" class="errors"></p>
      </div>
    </div>

    <section class="next paper-only">
      <h2>{t.nextSteps}</h2>
      <ol>{t.paperSteps.map((step) => <li set:html={step} />)}</ol>
    </section>

    <section class="next client-only">
      <h2>{t.nextSteps}</h2>
      <ol>{t.playerSteps.map((step) => <li set:html={step} />)}</ol>
    </section>

    <section class="next link-only">
      <h2>{t.nextSteps}</h2>
      <ol>{t.linkSteps.map((step) => <li set:html={step} />)}</ol>
      <p class="muted">{t.linkNote}</p>
    </section>
  </div>

  <style>
    .gen[data-mode='player'] .paper-only,
    .gen[data-mode='link'] .paper-only,
    .gen[data-mode='paper'] .client-only,
    .gen[data-mode='link'] .client-only,
    .gen[data-mode='paper'] .mesh-only,
    .gen[data-mode='paper'] .link-only,
    .gen[data-mode='player'] .link-only,
    .gen[data-mode='link'] #acts-file { display: none; }
  </style>

  <script is:inline type="application/json" id="gen-strings" set:html={scriptStrings} />
  <script>
    import { buildToml, buildPaperYaml, validate, validatePaper, splitList,
             buildJoinLink, validateJoinLink, decodeJoinLink, randomSecret, type GenInput } from '../../lib/genConfig';
    import { format } from '../../i18n/format';
    import type { Strings } from '../../i18n';

    // Strings in the page's language, from #gen-strings.
    const { script: t, config: messages } = JSON.parse(document.getElementById('gen-strings')!.textContent!) as
      { script: Strings['generator']['script']; config: Strings['config'] };

    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

    const gen = $<HTMLDivElement>('gen');
    const modeButtons = {
      paper: $<HTMLButtonElement>('mode-paper'),
      player: $<HTMLButtonElement>('mode-player'),
      link: $<HTMLButtonElement>('mode-link'),
    };

    const network = $<HTMLInputElement>('f-network');
    const secret = $<HTMLInputElement>('f-secret');
    const relays = $<HTMLTextAreaElement>('f-relays');
    const dhcp = $<HTMLInputElement>('f-dhcp');
    const ipv4 = $<HTMLInputElement>('f-ipv4');
    const serverip = $<HTMLInputElement>('f-serverip');
    const serverport = $<HTMLInputElement>('f-serverport');
    const label = $<HTMLInputElement>('f-label');
    const hostKey = $<HTMLInputElement>('f-hostkey');

    const lblPort = $<HTMLElement>('lbl-port');
    const lblOut = $<HTMLElement>('lbl-out');
    const out = $<HTMLElement>('out');
    const errs = $<HTMLElement>('errs');
    const toast = $<HTMLElement>('toast');
    const copyBtn = $<HTMLButtonElement>('copy');
    const dlBtn = $<HTMLButtonElement>('download');
    const copyLinkBtn = $<HTMLButtonElement>('copy-link');

    type Mode = keyof typeof modeButtons;
    let mode: Mode = 'paper';

    function read(): GenInput {
      const port = parseInt(serverport.value, 10) || 0;
      return {
        network: network.value,
        secret: secret.value,
        relays: splitList(relays.value),
        dhcp: dhcp.checked,
        ipv4: ipv4.value,
        serverIp: serverip.value,
        serverPort: port,
        label: label.value,
        virtualPort: port,
        hostKey: hostKey.value,
        hostName: loadedHostName,
        direct: loadedDirect,
      };
    }

    let loadedHostName: string | undefined; // kept from a loaded link, so saving it keeps its invite
    let loadedDirect: boolean | undefined;  // likewise: the link's relay is the host itself
    let current = '';       // paper/player output (Copy + Download)
    let currentLink = '';   // link mode: the etmc:// link
    function render() {
      ipv4.disabled = dhcp.checked;
      const input = read();

      if (mode === 'link') {
        const problems = validateJoinLink(input, messages);
        currentLink = buildJoinLink(input);
        out.textContent = currentLink;
        errs.textContent = problems.join(' ');
        copyLinkBtn.disabled = problems.length > 0;
        lblPort.textContent = t.hostPort;
        lblOut.textContent = t.joinLink;
        return;
      }

      const paper = mode === 'paper';
      const problems = paper ? validatePaper(input, messages) : validate(input, messages);
      current = paper ? buildPaperYaml(input) : buildToml(input);
      out.textContent = current;
      errs.textContent = problems.join(' ');
      const ok = problems.length === 0;
      copyBtn.disabled = !ok;
      dlBtn.disabled = !ok;
      lblPort.textContent = paper ? t.networkPort : t.serverPort;
      lblOut.textContent = paper ? 'config.yml' : 'etmc.toml';
    }

    function setMode(m: Mode) {
      mode = m;
      gen.dataset.mode = m;
      for (const [name, button] of Object.entries(modeButtons)) {
        button.setAttribute('aria-pressed', String(name === m));
      }
      render();
    }

    const linkInput = $<HTMLInputElement>('f-link');
    const loadMsg = $<HTMLElement>('load-msg');

    function loadLink() {
      const text = linkInput.value;
      loadMsg.classList.remove('bad');
      loadMsg.textContent = '';
      if (!text.trim()) return;
      try {
        const link = decodeJoinLink(text, messages);
        network.value = link.network;
        secret.value = link.secret;
        relays.value = link.relays.join('\n');
        serverip.value = link.serverIp;
        serverport.value = String(link.serverPort);
        label.value = link.label;
        hostKey.value = link.hostKey ?? '';
        loadedHostName = link.hostName;
        loadedDirect = link.direct;
        // Cleared so the secret isn't left in a second field that no longer matches the form.
        linkInput.value = '';
        loadMsg.textContent = format(t.loaded, { name: link.label || link.network });
        // Paper mode hides the server IP and name, so show a mode that has every field.
        setMode(mode === 'paper' ? 'link' : mode);
      } catch (e) {
        loadMsg.classList.add('bad');
        loadMsg.textContent = (e as Error).message;
      }
    }
    linkInput.addEventListener('input', loadLink);

    // One timer, so a second message doesn't get wiped early by the first one's timeout.
    let toastTimer = 0;
    function flash(msg: string) {
      toast.textContent = msg;
      window.clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => { toast.textContent = ''; }, 2200);
    }

    async function copyText(text: string) {
      try {
        await navigator.clipboard.writeText(text);
        flash(t.copied);
      } catch {
        flash(t.copyFailed);
      }
    }

    [network, secret, relays, ipv4, serverip, serverport, label].forEach((el) =>
      el.addEventListener('input', render));
    dhcp.addEventListener('change', render);
    for (const [name, button] of Object.entries(modeButtons)) {
      button.addEventListener('click', () => setMode(name as Mode));
    }

    copyBtn.addEventListener('click', () => copyText(current));
    copyLinkBtn.addEventListener('click', () => copyText(currentLink));

    dlBtn.addEventListener('click', () => {
      const paper = mode === 'paper';
      const name = paper ? 'config.yml' : 'etmc.toml';
      const blob = new Blob([current], { type: paper ? 'text/yaml' : 'application/toml' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = name;
      document.body.appendChild(a);
      a.click();
      a.remove();
      // Revoking synchronously can cancel the download in some browsers, so let the click settle first.
      window.setTimeout(() => URL.revokeObjectURL(url), 0);
      flash(format(t.downloaded, { file: name }));
    });

    $<HTMLButtonElement>('new-secret').addEventListener('click', () => {
      secret.value = randomSecret();
      render();
    });

    secret.value = randomSecret();
    setMode('paper');
  </script>
</BaseLayout>
