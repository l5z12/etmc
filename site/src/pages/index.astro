---
import BaseLayout from '../layouts/BaseLayout.astro';
import VoxelScene from '../components/VoxelScene.astro';
import RouteDemo from '../components/RouteDemo.astro';
import Block from '../components/Block.astro';

const usual = [
  'Log in to your router',
  'Give your PC a fixed local IP',
  'Forward port 25565',
  'Look up your public IP',
  "Find out your ISP doesn't allow it",
  'Give up and pay for hosting',
];
---

<BaseLayout title="etmc">
  <section class="hero ink">
    <div class="wrap hero-grid">
      <div>
        <h1>Send a link.<br /><span>Play together.</span></h1>
        <p class="lead">
          etmc is a Minecraft mod that opens your world to friends over a peer-to-peer network. No port
          forwarding, nothing else to install, no admin rights.
        </p>
        <div class="actions">
          <a class="btn primary" href="https://github.com/L5Z12/etmc/releases">Download etmc</a>
          <a class="btn" href="/docs/getting-started">Read the guide</a>
        </div>
      </div>
      <VoxelScene />
    </div>
  </section>

  <section class="wrap compare">
    <h2 class="big">Skip the router settings.</h2>
    <div class="compare-grid">
      <div class="usual">
        <h3>The usual way</h3>
        <ol>{usual.map((step) => <li>{step}</li>)}</ol>
      </div>
      <div class="better">
        <h3>With etmc</h3>
        <ol>
          <li><strong>Add a relay.</strong> You only do this once.</li>
          <li><strong>Press <kbd>G</kbd></strong> and choose Host this world.</li>
          <li><strong>Send the link.</strong> Friends paste it into Direct Connect.</li>
        </ol>
        <a class="btn primary" href="/docs/getting-started">See how it works</a>
      </div>
    </div>
    <p class="compare-link">Already using ZeroTier, Tailscale or Hamachi? <a href="/compare">See how etmc compares</a>.</p>
  </section>

  <section class="ink band">
    <div class="wrap"><RouteDemo /></div>
  </section>

  <section class="wrap tiles">
    <div class="tile wide">
      <Block color="#62d0e0" />
      <h3>Works where you play</h3>
      <p>On Windows, Linux and macOS, with the loader you already use.</p>
      <ul class="tags"><li>Fabric</li><li>NeoForge</li><li>Forge</li><li>Paper</li></ul>
    </div>
    <div class="tile">
      <Block color="#5fae6b" />
      <h3>Your mods stay</h3>
      <p>To Minecraft it's a normal server, so other mods keep working, including ViaFabricPlus.</p>
    </div>
    <div class="tile">
      <Block color="#fcdc5f" />
      <h3>All in the game</h3>
      <p>No VPN app, no driver and no admin prompt. It starts and stops with your world.</p>
    </div>
    <div class="tile wide">
      <Block color="#c0564f" />
      <h3>Free and open source</h3>
      <p>etmc is GPL-3.0 and built on <a href="https://github.com/EasyTier/EasyTier">EasyTier</a>. You choose the relay, so there's no account and no company in the middle.</p>
    </div>
  </section>

  <section class="server">
    <div class="wrap">
      <div>
        <h2 class="big">Running a server?</h2>
        <p>The Paper plugin puts your server on the network. Create its config in a minute, then share one link with your players.</p>
      </div>
      <a class="btn dark" href="/generator">Open the generator</a>
    </div>
  </section>
</BaseLayout>
