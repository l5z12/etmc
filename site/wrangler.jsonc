{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "etmc",
  "compatibility_date": "2026-06-16",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "etmc.l5z12.dev",
      "custom_domain": true
    }
  ]
}
